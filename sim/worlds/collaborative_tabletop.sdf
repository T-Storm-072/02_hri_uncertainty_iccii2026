<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="collaborative_tabletop">
    <!-- Physical Engine Parameters: DART 1000 Hz -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>1.0 -1.0 2.5 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.4 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.32 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Heavy Workbench Table -->
    <model name="workbench_table">
      <static>true</static>
      <pose>0.45 0.0 0.375 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box><size>0.90 1.20 0.05</size></box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box><size>0.90 1.20 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.45 0.48 0.52 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target YCB Objects on Table -->
    <model name="ycb_cracker_box">
      <pose>0.55 0.10 0.84 0 0 0.15</pose>
      <link name="box_link">
        <inertial>
          <mass>0.411</mass>
          <inertia>
            <ixx>0.0015</ixx><iyy>0.0022</iyy><izz>0.0011</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.16 0.21</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.16 0.21</size></box></geometry>
          <material>
            <ambient>0.8 0.15 0.1 1</ambient>
            <diffuse>0.85 0.2 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Occluder Barrier -->
    <model name="visual_occluder">
      <static>true</static>
      <pose>0.48 0.10 0.83 0 0 0</pose>
      <link name="shield_link">
        <visual name="visual">
          <geometry><box><size>0.012 0.15 0.18</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.45 0.85</ambient>
            <diffuse>0.5 0.52 0.55 0.85</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tabletop Overhead/Oblique Camera Sensor -->
    <model name="workspace_camera">
      <static>true</static>
      <pose>0.72 -0.92 1.28 0 0.58 2.05</pose>
      <link name="camera_link">
        <sensor name="tabletop_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
